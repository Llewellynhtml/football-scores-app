# Copy values into an untracked .env.mariadb.local file or set them in one CMD window.
# Placeholders only. Never paste Hostinger or real API-Football credentials here.
MARIADB_ISOLATED_DATABASE=true
DATABASE_PROVIDER=mysql
FOOTBALL_PERSISTENCE_ENABLED=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=football_scores_test_m2
MYSQL_USER=football_m2_test
MYSQL_PASSWORD=replace-with-local-only-password
MYSQL_CONNECTION_LIMIT=5
MYSQL_MAX_IDLE=2
MYSQL_IDLE_TIMEOUT_MS=10000
MYSQL_QUEUE_LIMIT=50
MYSQL_CONNECT_TIMEOUT_MS=5000
MYSQL_ACQUIRE_TIMEOUT_MS=5000
MYSQL_LOCK_WAIT_TIMEOUT_SECONDS=5
API_FOOTBALL_BASE_URL=http://127.0.0.1:4310
API_FOOTBALL_KEY=integration-test-key
API_SPORTS_KEY=integration-test-key
FOOTBALL_QUOTA_SCOPE=mariadb-m2-local-test
CRON_SECRET=local-m2-diagnostics-only
MARIADB_LOAD_CRON_SECRET=local-m2-diagnostics-only
MARIADB_LOAD_MAX_PROVIDER_REQUESTS=1
MARIADB_LOAD_WARM_REQUESTS=40
FOOTBALL_FIXED_DATE_UTC=2026-11-25
MARIADB_DATABASE_CAPACITY_MB=3072
MARIADB_CAPACITY_WARNING_PERCENT=60
MARIADB_CAPACITY_ALERT_PERCENT=70
