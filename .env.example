# One API-Sports account key can be used as the shared server-side key.
# Keep real secrets in Hostinger only; never commit them.
API_SPORTS_KEY=

API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Use "free" for plan-aware restrictions or "current" for a plan that permits current data.
API_FOOTBALL_DATA_MODE=free
# Competition season selection is independent from fixture calendar dates.
# Omit to select from returned league metadata; set only to a season actually available to the plan.
API_FOOTBALL_FREE_SEASON=
# Optional inclusive provider-supported fixture-date window (YYYY-MM-DD).
API_FOOTBALL_FREE_DATE_FROM=
API_FOOTBALL_FREE_DATE_TO=
# Provider data is requested in UTC; visitor-local conversion happens in the browser.
FOOTBALL_SOURCE_TIMEZONE=UTC

API_BASKETBALL_KEY=
API_BASKETBALL_BASE_URL=https://v1.basketball.api-sports.io

API_NBA_KEY=
API_NBA_BASE_URL=https://v2.nba.api-sports.io

API_AMERICAN_FOOTBALL_KEY=
API_AMERICAN_FOOTBALL_BASE_URL=https://v1.american-football.api-sports.io

API_RUGBY_KEY=
API_RUGBY_BASE_URL=https://v1.rugby.api-sports.io

API_FORMULA1_KEY=
API_FORMULA1_BASE_URL=https://v1.formula-1.api-sports.io

API_BASEBALL_KEY=
API_BASEBALL_BASE_URL=https://v1.baseball.api-sports.io

API_HOCKEY_KEY=
API_HOCKEY_BASE_URL=https://v1.hockey.api-sports.io

API_MMA_KEY=
API_MMA_BASE_URL=https://v1.mma.api-sports.io

API_VOLLEYBALL_KEY=
API_VOLLEYBALL_BASE_URL=https://v1.volleyball.api-sports.io

API_HANDBALL_KEY=
API_HANDBALL_BASE_URL=https://v1.handball.api-sports.io

API_AFL_KEY=
API_AFL_BASE_URL=https://v1.afl.api-sports.io

CRON_SECRET=
SITE_URL=
CRON_MODE=fixtures

# Optional persistent provider cache. Keep disabled until reviewed migrations are applied.
FOOTBALL_PERSISTENCE_ENABLED=false
# Explicit provider selection. Supabase remains the default during evaluation.
DATABASE_PROVIDER=supabase
FOOTBALL_QUOTA_GUARD_ENABLED=true
FOOTBALL_DAILY_REQUEST_LIMIT=100
FOOTBALL_QUOTA_RESERVE=10
FOOTBALL_PER_MINUTE_REQUEST_LIMIT=10
FOOTBALL_PER_MINUTE_RESERVE=2
# Stable, non-secret identifier for one provider quota account/environment.
FOOTBALL_QUOTA_SCOPE=api-football-default
FOOTBALL_QUOTA_COOLDOWN_SECONDS=300
FOOTBALL_USAGE_QUEUE_MAX=100
FOOTBALL_USAGE_RETRY_MAX=3
# Enable only after the subscribed plan's fixtures?ids support is verified.
API_FOOTBALL_FIXTURE_BATCHING_ENABLED=false
# Server-side Supabase project URL and keys. Use placeholders only in this file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Backward-compatible alias: SUPABASE_ANON_KEY=
# Privileged server-only key. Never prefix with NEXT_PUBLIC_ or expose to browser code.
SUPABASE_SECRET_KEY=your-secret-key
# Backward-compatible alias: SUPABASE_SERVICE_ROLE_KEY=

# MariaDB settings are server-only. Do not use NEXT_PUBLIC_ names.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=5
MYSQL_MAX_IDLE=2
MYSQL_IDLE_TIMEOUT_MS=10000
MYSQL_QUEUE_LIMIT=50
MYSQL_CONNECT_TIMEOUT_MS=5000
MYSQL_ACQUIRE_TIMEOUT_MS=5000
MYSQL_LOCK_WAIT_TIMEOUT_SECONDS=5
# Provisional until hPanel confirms the individual database limit.
MARIADB_DATABASE_CAPACITY_MB=3072
MARIADB_CAPACITY_WARNING_PERCENT=60
MARIADB_CAPACITY_ALERT_PERCENT=70
